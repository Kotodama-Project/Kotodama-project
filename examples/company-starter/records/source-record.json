{
  "kind": "record_template",
  "spec_version": "0.1",
  "id": "source-record-template",
  "status": "example",
  "artifact": "source_record",
  "purpose": "Preserve an authorized source as provenance-bound evidence without promoting it to intent or truth.",
  "canonical_owner": "evidence-store",
  "required_fields": [
    "source_id",
    "source_locator_ref",
    "observed_at",
    "digest_sha256",
    "access_or_consent_ref",
    "retention_policy_ref"
  ],
  "authority": {
    "creator_role": "evidence-steward",
    "verifier_role": "independent-verifier",
    "promotion_required_for_current_truth": true
  },
  "retention": {
    "mode": "policy_ref",
    "policy_ref": "retention-policy:replace-with-governed-reference"
  },
  "denied_claims": [
    "self_approval",
    "self_promotion",
    "current_truth_without_promotion"
  ]
}
