      "id": "AI-AUDITOR",
      "role": "Evidence Auditor",
      "capability_scope": [
        "receipt validation",
        "policy comparison",
        "exception detection",
        "independently review originating intent, context position and approach",
        "require disposition of findings and reassess changed approaches"
