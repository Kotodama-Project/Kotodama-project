  "dynamic_agent_context_policy": {
    "policy_id": "DYNAMIC-AGENT-CONTEXT-20260906",
    "intent": "Function-like explicit inputs produce a hierarchical, updatable agent context document that remains available during work.",
    "document_form": "AGENTS.md-style generated contextual projection; exact filename/runtime integration remains open",
    "composition_layers": [
      "applicable_fixed_policy_references",
      "upstream_intent_and_purpose_path",
      "responsible_agent_role_and_scope",
      "current_task_session_position",
      "relevant_source_and_knowledge_references"
    ],
    "function_contract": {
      "inputs": [
        "original_intent_and_corrections_with_revisions",
        "required_purpose_ancestors_and_dependencies",
        "responsible_role_manifest_ref",
        "current_task_session_owner_and_progress",
        "current_source_and_knowledge_refs",
        "access_scope_and_grant_refs",
        "context_budget_and_required_fields",
        "change_and_freshness_signals"
      ],
      "outputs": [
        "compact_always_available_working_context",
        "source_and_parent_references_for_expansion",
        "context_revision_and_dependency_manifest",
        "freshness_conflicts_and_missing_information",
        "ready_or_needs_resolution_or_stale_or_denied_state"
      ],
      "input_coverage_and_semantic_constraints_checked": true,
      "missing_required_context_not_silently_filled": true,
      "function_is_contract_not_implemented_runtime": true
    },
    "always_available": {
      "agent_side": "the compact required context is available/reinjected at session start, resume, compaction and work-boundary refresh",
      "human_side": "a current-context view keeps purpose, responsibility, position, constraints, next action and freshness inspectable during work",
      "required_fields": [
        "originating_intent",
        "current_position_and_why",
        "responsible_owner",
        "active_constraints_and_scope",
        "next_action_and_unresolved",
        "context_revision_and_freshness"
      ],
      "detailed_sources_progressively_loaded": true,
      "not_all_history_or_all_layers_pasted_each_time": true,
      "continuous_visibility_not_literal_permanent_model_memory": true
    },
    "refresh_policy": {
      "triggers": [
        "source_or_policy_revision_change",
        "intent_correction_or_withdrawal",
        "owner_role_or_task_state_change",
        "dependency_or_grant_revocation",
        "detected_contradiction",
        "stale_or_expired_context_signal",
        "session_or_work_boundary"
      ],
      "flow": [
        "compare_current_dependencies_and_access",
        "mark_affected_projection_stale",
        "rebuild_only_affected_context_and_wiki_views",
        "check_required_intent_and_constraint_retention",
        "record_diff_source_bindings_and_review_disposition",
        "replace_current_projection_after_checks"
      ],
      "old_looking_content_is_a_review_trigger_not_falsehood_proof": true,
      "no_rebuild_when_inputs_and_evidence_unchanged": true,
      "preserve_original_sources_and_prior_revisions": true,
      "stale_restricted_content_not_reintroduced": true
    },
    "knowledge_wiki_integration": {
      "owner_role_ref": "AI-LIBRARIAN",
      "context_and_wiki_share_source_revision_and_invalidation_lineage": true,
      "update_pages_indexes_and_context_from_same_authorized_sources": true,
      "no_parallel_company_truth": true,
      "projection_does_not_self_promote_to_policy_or_approval": true
    },
    "trust_boundary": {
      "fixed_authority_rules_not_overwritten_by_generated_context": true,
      "lower_layer_cannot_relax_parent_constraints_or_expand_grants": true,
      "retrieved_content_is_evidence_not_executable_instruction": true,
      "conflicts_require_explicit_resolution": true,
      "actor_scoped_access_checked_before_context_delivery": true
    },
    "runtime_status": "policy_and_required_contract_only_not_deployed",
    "initiative_ref": "INIT-DYNAMIC-AGENT-CONTEXT"
  },
