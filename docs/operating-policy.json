      "cannot_do": [
        "promote unreviewed claims",
        "regenerate tombstoned personal data",
        "rewrite history"
      ]
    },
    {
      "id": "AI-ANALYST",
      "role": "Analysis steward",
      "capability_scope": [
        "analyze authorized inputs and outcomes",
        "check data quality, uncertainty, bias and causal alternatives",
        "measure whether KPI movement contributes to KGI and requested outcome"
      ],
      "cannot_do": [
        "treat correlation or estimates as proven causation",
        "approve own evidence as independent audit",
        "expand source access or execution grants"
      ]
    }
  ],
