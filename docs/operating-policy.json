      "cannot_do": [
        "execute reviewed work",
        "approve own work",
        "alter evidence"
      ]
    },
    {
      "id": "AI-LIBRARIAN",
      "role": "Librarian",
      "capability_scope": [
        "typed links",
        "projection refresh",
        "source provenance",
        "own knowledge quality, freshness, retrieval and lifecycle coordination",
        "design bounded ingestion, indexing, page maintenance and retrieval subagent tasks",
        "integrate Encoder Steward capability only after current contract and activation checks"
