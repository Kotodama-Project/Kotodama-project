{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dj-thank/Kotodama-project/schemas/company-pack-public-preview-check.schema.json",
  "title": "Kotodama Company Pack Public Preview Check",
  "$comment": "A deterministic read-only aggregate of the public starter structural validator, Catalog projection, customization boundary, and false-claim boundary. It does not grant authority, execute runtime work, promote a candidate, or open Public Beta access. A validator-PASS Pack may omit optional manifest.records; PASS may therefore report counts.records as zero while still requiring validated files, Blocks, MOCs, projection alignment, and the fixed false-claim boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "status",
    "counts",
    "checks",
    "refusal_reason",
    "claims",
    "public_beta"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "PASS"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "counts": {
            "properties": {
              "validated_files": {"minimum": 1},
              "blocks": {"minimum": 1},
              "mocs": {"minimum": 1}
            }
          },
          "checks": {
            "items": {
              "properties": {"status": {"const": "PASS"}}
            }
          },
          "refusal_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "REFUSED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "counts": {
            "properties": {
              "validated_files": {"const": 0},
              "blocks": {"const": 0},
              "records": {"const": 0},
              "mocs": {"const": 0},
              "replacement_required": {"const": 0},
              "review_required": {"const": 0},
              "evidence_required": {"const": 0}
            }
          },
          "checks": {
            "items": {
              "properties": {"status": {"const": "REFUSED"}}
            }
          },
          "refusal_reason": {
            "enum": [
              "INPUT_NOT_DIRECTORY",
              "INVALID_PACK",
              "INTERNAL_CONTRACT_REFUSAL"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "kind": {"const": "company_pack_public_preview_check"},
    "version": {"const": "1.0"},
    "status": {"enum": ["PASS", "REFUSED"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validated_files",
        "blocks",
        "records",
        "mocs",
        "replacement_required",
        "review_required",
        "evidence_required"
      ],
      "properties": {
        "validated_files": {"type": "integer", "minimum": 0},
        "blocks": {"type": "integer", "minimum": 0},
        "records": {"type": "integer", "minimum": 0},
        "mocs": {"type": "integer", "minimum": 0},
        "replacement_required": {"type": "integer", "minimum": 0},
        "review_required": {"type": "integer", "minimum": 0},
        "evidence_required": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {
            "enum": [
              "pack_structure",
              "catalog_projection",
              "customization_boundary",
              "claim_boundary"
            ]
          },
          "status": {"enum": ["PASS", "REFUSED"]}
        }
      }
    },
    "refusal_reason": {
      "oneOf": [
        {"type": "null"},
        {
          "enum": [
            "INPUT_NOT_DIRECTORY",
            "INVALID_PACK",
            "INTERNAL_CONTRACT_REFUSAL"
          ]
        }
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_approval_verified",
        "runtime_verified",
        "promotion_verified",
        "current_truth_changed",
        "public_beta_go"
      ],
      "properties": {
        "human_approval_verified": {"const": false},
        "runtime_verified": {"const": false},
        "promotion_verified": {"const": false},
        "current_truth_changed": {"const": false},
        "public_beta_go": {"const": false}
      }
    },
    "public_beta": {"const": "NO_GO_UNPUBLISHED"}
  }
}
