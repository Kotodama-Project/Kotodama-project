{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kotodama-Project/Kotodama-project/schemas/task-contract.schema.json",
  "title": "Task Contract",
  "description": "A provider-neutral, bounded work contract with explicit authority, evidence, and rollback boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "candidate_status",
    "task_id",
    "revision",
    "state",
    "objective",
    "scope",
    "input_refs",
    "dependency_task_ids",
    "required_capability_ids",
    "acceptance_checks",
    "authority",
    "budgets",
    "stop_conditions",
    "rollback"
  ],
  "properties": {
    "kind": {
      "const": "task_contract"
    },
    "schema_version": {
      "const": "1.0"
    },
    "candidate_status": {
      "const": "candidate_only",
      "description": "This contract is descriptive and does not grant execution authority."
    },
    "task_id": {
      "$ref": "#/$defs/taskId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "state": {
      "enum": [
        "draft",
        "ready",
        "claimed",
        "running",
        "blocked",
        "verifying",
        "review",
        "complete",
        "cancelled"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "input_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "dependency_task_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taskId"
      }
    },
    "required_capability_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "worker-capability-catalog.schema.json#/$defs/capabilityId"
      }
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/acceptanceCheck"
      }
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "\\S"
      }
    },
    "rollback": {
      "$ref": "#/$defs/rollback"
    }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,62}[a-z0-9]$"
    },
    "artifactRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9+.-]*:[A-Za-z0-9][A-Za-z0-9._/@+-]{1,150}$"
    },
    "actionId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]{1,63}$"
    },
    "roleId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]{1,63}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "excluded_resources"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "excluded_resources": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      }
    },
    "acceptanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "description",
        "evidence_required"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9._-]{1,63}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "evidence_required": {
          "type": "boolean"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_role",
        "grants_execution",
        "allowed_actions",
        "denied_actions"
      ],
      "properties": {
        "owner_role": {
          "$ref": "#/$defs/roleId"
        },
        "grants_execution": {
          "const": false
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/actionId"
          }
        },
        "denied_actions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/actionId"
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "timeout_seconds"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reversible",
        "strategy",
        "steps"
      ],
      "properties": {
        "reversible": {
          "type": "boolean"
        },
        "strategy": {
          "enum": [
            "restore_previous",
            "compensating_action",
            "not_applicable"
          ]
        },
        "steps": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reversible": {
                "const": true
              }
            },
            "required": [
              "reversible"
            ]
          },
          "then": {
            "properties": {
              "strategy": {
                "not": {
                  "const": "not_applicable"
                }
              },
              "steps": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "strategy": {
                "const": "not_applicable"
              },
              "steps": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
