{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kotodama-Project/Kotodama-project/schemas/knowledge-registry.schema.json",
  "title": "Kotodama Knowledge Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "reviewed_at", "inventory_scope", "fact_families", "contradiction_policy"],
  "properties": {
    "version": {"const": 1},
    "status": {"enum": ["candidate_only", "promoted"]},
    "reviewed_at": {"type": "string", "format": "date"},
    "inventory_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude", "minimum_classification_coverage"],
      "properties": {
        "include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "minimum_classification_coverage": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "fact_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "canonical_path", "human_projection_paths", "classification_patterns", "freshness", "owner_role", "required_provenance"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "description": {"type": "string", "minLength": 1},
          "canonical_path": {"type": "string", "minLength": 1},
          "human_projection_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "classification_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "freshness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "max_age_days", "severity"],
            "properties": {
              "mode": {"enum": ["json_field", "date_line", "manual"]},
              "field": {"type": "string", "minLength": 1},
              "prefix": {"type": "string", "minLength": 1},
              "max_age_days": {"type": ["integer", "null"], "minimum": 1},
              "severity": {"enum": ["info", "warning", "error", "critical"]}
            }
          },
          "owner_role": {"type": "string", "minLength": 1},
          "required_provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "contradiction_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity_1_examples", "required_action", "agent_may_auto_resolve"],
      "properties": {
        "severity_1_examples": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_action": {"type": "string", "minLength": 1},
        "agent_may_auto_resolve": {"const": false}
      }
    }
  }
}
