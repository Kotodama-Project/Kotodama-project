{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dj-thank/Kotodama-project/schemas/company-pack-review-response-verification.schema.json",
  "title": "Kotodama Company Pack Review Response Verification",
  "$comment": "A match proves structural item-response binding only. It does not verify reviewer identity, authority, Human approval, an overall Decision, evidence, Promotion, Current Truth, or Public Beta GO.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "status",
    "reason",
    "pack_id",
    "request_binding",
    "response_binding",
    "candidate_binding",
    "review_summary",
    "unresolved_evidence",
    "claims",
    "public_beta"
  ],
  "properties": {
    "kind": {"const": "company_pack_review_response_verification"},
    "version": {"const": "1.0"},
    "status": {"enum": ["ITEM_RESPONSES_MATCH_REQUEST", "RESPONSE_MISMATCH"]},
    "reason": {
      "oneOf": [
        {"type": "null"},
        {
          "enum": [
            "REQUEST_INVALID",
            "RESPONSE_INVALID",
            "SOURCE_DRIFT_DETECTED",
            "ITEM_BINDING_MISMATCH",
            "INCOMPLETE_ITEM_RESPONSES"
          ]
        }
      ]
    },
    "pack_id": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        {"type": "null"}
      ]
    },
    "request_binding": {
      "oneOf": [
        {"$ref": "#/$defs/file_binding"},
        {"type": "null"}
      ]
    },
    "response_binding": {
      "oneOf": [
        {"$ref": "#/$defs/file_binding"},
        {"type": "null"}
      ]
    },
    "candidate_binding": {
      "oneOf": [
        {"$ref": "#/$defs/candidate_binding"},
        {"type": "null"}
      ]
    },
    "review_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "expected_items", "completed_items", "outcome_counts", "selected_outcome"],
      "properties": {
        "state": {"enum": ["ALL_ITEM_RESPONSES_PRESENT", "UNKNOWN"]},
        "expected_items": {"type": "integer", "minimum": 0},
        "completed_items": {"type": "integer", "minimum": 0},
        "outcome_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accept", "request_changes", "reject"],
          "properties": {
            "accept": {"type": "integer", "minimum": 0},
            "request_changes": {"type": "integer", "minimum": 0},
            "reject": {"type": "integer", "minimum": 0}
          }
        },
        "selected_outcome": {"type": "null"}
      }
    },
    "unresolved_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "item_count"],
      "properties": {
        "state": {"enum": ["EVIDENCE_REQUIRED", "UNKNOWN"]},
        "item_count": {"type": "integer", "minimum": 0}
      }
    },
    "claims": {"$ref": "#/$defs/claims"},
    "public_beta": {"const": "NO_GO_UNPUBLISHED"}
  },
  "$defs": {
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["saved_bundle", "bundle_digest", "binding_count"],
      "properties": {
        "saved_bundle": {"$ref": "#/$defs/file_binding"},
        "bundle_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "canonicalization", "value"],
          "properties": {
            "algorithm": {"const": "SHA-256"},
            "canonicalization": {"const": "utf8-json-sort-keys-no-whitespace-v1"},
            "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "binding_count": {"type": "integer", "minimum": 1}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_identity_verified",
        "reviewer_authority_verified",
        "reviewer_independence_verified",
        "governed_review_completed",
        "human_approval_verified",
        "candidate_bound_human_decision_verified",
        "external_evidence_verified",
        "promotion_verified",
        "current_truth_changed",
        "runtime_ready",
        "final_human_go",
        "public_beta_go"
      ],
      "properties": {
        "reviewer_identity_verified": {"const": false},
        "reviewer_authority_verified": {"const": false},
        "reviewer_independence_verified": {"const": false},
        "governed_review_completed": {"const": false},
        "human_approval_verified": {"const": false},
        "candidate_bound_human_decision_verified": {"const": false},
        "external_evidence_verified": {"const": false},
        "promotion_verified": {"const": false},
        "current_truth_changed": {"const": false},
        "runtime_ready": {"const": false},
        "final_human_go": {"const": false},
        "public_beta_go": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ITEM_RESPONSES_MATCH_REQUEST"}}},
      "then": {
        "properties": {
          "reason": {"type": "null"},
          "pack_id": {"type": "string"},
          "request_binding": {"$ref": "#/$defs/file_binding"},
          "response_binding": {"$ref": "#/$defs/file_binding"},
          "candidate_binding": {"$ref": "#/$defs/candidate_binding"},
          "review_summary": {
            "properties": {
              "state": {"const": "ALL_ITEM_RESPONSES_PRESENT"},
              "expected_items": {"type": "integer", "minimum": 0},
              "completed_items": {"type": "integer", "minimum": 0}
            }
          },
          "unresolved_evidence": {
            "properties": {
              "state": {"const": "EVIDENCE_REQUIRED"},
              "item_count": {"type": "integer", "minimum": 0}
            }
          }
        }
      },
      "else": {
        "properties": {
          "reason": {"type": "string"},
          "pack_id": {"type": "null"},
          "request_binding": {"type": "null"},
          "response_binding": {"type": "null"},
          "candidate_binding": {"type": "null"},
          "review_summary": {
            "properties": {
              "state": {"const": "UNKNOWN"},
              "expected_items": {"const": 0},
              "completed_items": {"const": 0},
              "outcome_counts": {
                "properties": {
                  "accept": {"const": 0},
                  "request_changes": {"const": 0},
                  "reject": {"const": 0}
                }
              }
            }
          },
          "unresolved_evidence": {
            "properties": {
              "state": {"const": "UNKNOWN"},
              "item_count": {"const": 0}
            }
          }
        }
      }
    }
  ]
}
