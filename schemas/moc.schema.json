{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dj-thank/Kotodama-project/schemas/moc.schema.json",
  "title": "Kotodama Map of Content",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "spec_version", "id", "status", "authority", "title", "refs"],
  "properties": {
    "kind": {"const": "moc"},
    "spec_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "status": {
      "enum": ["example", "draft", "candidate_only", "locally_verified"]
    },
    "authority": {"const": "navigation_only"},
    "projection": {"const": "flow_subsequence"},
    "title": {"type": "string", "minLength": 1},
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
