{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kotodama-Project/Kotodama-project/schemas/okf.schema.json",
  "title": "Kotodama OKF Control Plane",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "reviewed_at", "north_star", "current_state", "kgis", "key_factors", "phases"],
  "properties": {
    "version": {"const": 1},
    "status": {"enum": ["candidate_only", "promoted"]},
    "reviewed_at": {"type": "string", "format": "date"},
    "review_interval_days": {"type": "integer", "minimum": 1},
    "north_star": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "principle", "beneficiary"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "principle": {"type": "string", "minLength": 1},
        "beneficiary": {"type": "string", "minLength": 1}
      }
    },
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_date", "public_maturity", "strengths", "gaps"],
      "properties": {
        "snapshot_date": {"type": "string", "format": "date"},
        "public_maturity": {"type": "string", "minLength": 1},
        "strengths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "gaps": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "kgis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "definition", "target", "baseline_status", "baseline", "measurement_phase", "guardrails"],
        "properties": {
          "id": {"type": "string", "pattern": "^KGI-[0-9]{2}$"},
          "name": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operator", "value", "unit"],
            "properties": {
              "operator": {"enum": [">=", ">", "<=", "<", "=="]},
              "value": {"type": "number"},
              "unit": {"type": "string", "minLength": 1}
            }
          },
          "baseline_status": {"enum": ["not_measured", "measured", "retired"]},
          "baseline": {"type": ["number", "string", "object", "array", "null"]},
          "measurement_phase": {"type": "string", "pattern": "^P[0-9]+$"},
          "guardrails": {"type": "array", "items": {"type": "string", "pattern": "^KGI-[0-9]{2}$"}, "uniqueItems": true}
        }
      }
    },
    "key_factors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "outcome", "kgi_links"],
        "properties": {
          "id": {"type": "string", "pattern": "^KF-[0-9]{2}$"},
          "name": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "minLength": 1},
          "kgi_links": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^KGI-[0-9]{2}$"}, "uniqueItems": true}
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "state", "objective", "key_factors", "exit_gates"],
        "properties": {
          "id": {"type": "string", "pattern": "^P[0-9]+$"},
          "name": {"type": "string", "minLength": 1},
          "state": {"enum": ["planned", "in_progress", "blocked", "complete", "retired"]},
          "objective": {"type": "string", "minLength": 1},
          "key_factors": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^KF-[0-9]{2}$"}, "uniqueItems": true},
          "exit_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
