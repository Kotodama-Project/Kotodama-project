{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kotodama-Project/Kotodama-project/schemas/company-pack-creation-report.schema.json",
  "title": "Kotodama Company Pack Creation Report",
  "$comment": "PASS proves only that a new non-overwritten draft Pack was generated and locally checked. READY_FOR_GOVERNED_REVIEW means static placeholders are closed; it does not prove Human approval, authority, retention enforcement, Promotion, Current Truth, runtime readiness, or Public Beta GO.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "status",
    "pack_id",
    "target",
    "validated_files",
    "rebound_mocs",
    "draft_documents",
    "static_customizations_applied",
    "customization_status",
    "claims",
    "public_beta",
    "errors"
  ],
  "properties": {
    "kind": {"const": "company_pack_creation_report"},
    "version": {"const": "1.0"},
    "status": {"enum": ["PASS", "FAIL"]},
    "pack_id": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        {"type": "null"}
      ]
    },
    "target": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "validated_files": {"type": "integer", "minimum": 0, "maximum": 22},
    "rebound_mocs": {"type": "integer", "minimum": 0, "maximum": 3},
    "draft_documents": {"type": "integer", "minimum": 0, "maximum": 22},
    "static_customizations_applied": {"type": "integer", "enum": [0, 19]},
    "customization_status": {
      "oneOf": [
        {"enum": ["CUSTOMIZATION_REQUIRED", "READY_FOR_GOVERNED_REVIEW"]},
        {"type": "null"}
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_intent_authenticated",
        "human_approval_verified",
        "authority_assignment_verified",
        "retention_policy_verified",
        "promotion_verified",
        "current_truth_changed"
      ],
      "properties": {
        "human_intent_authenticated": {"const": false},
        "human_approval_verified": {"const": false},
        "authority_assignment_verified": {"const": false},
        "retention_policy_verified": {"const": false},
        "promotion_verified": {"const": false},
        "current_truth_changed": {"const": false}
      }
    },
    "public_beta": {"const": "NO_GO_UNPUBLISHED"},
    "errors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {
        "properties": {
          "pack_id": {"type": "string"},
          "target": {"type": "string"},
          "validated_files": {"const": 22},
          "rebound_mocs": {"const": 3},
          "draft_documents": {"const": 22},
          "errors": {"maxItems": 0}
        },
        "oneOf": [
          {
            "properties": {
              "static_customizations_applied": {"const": 0},
              "customization_status": {"const": "CUSTOMIZATION_REQUIRED"}
            }
          },
          {
            "properties": {
              "static_customizations_applied": {"const": 19},
              "customization_status": {"const": "READY_FOR_GOVERNED_REVIEW"}
            }
          }
        ]
      },
      "else": {
        "properties": {
          "target": {"type": "null"},
          "validated_files": {"const": 0},
          "rebound_mocs": {"const": 0},
          "draft_documents": {"const": 0},
          "static_customizations_applied": {"const": 0},
          "customization_status": {"type": "null"},
          "errors": {"minItems": 1}
        }
      }
    }
  ]
}
