{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kotodama-Project/Kotodama-project/schemas/worker-capability-catalog.schema.json",
  "title": "Worker Capability Catalog",
  "description": "A provider-neutral candidate catalog of bounded capability declarations without connection, deployment, or runtime-availability details.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "catalog_id",
    "revision",
    "candidate_status",
    "evidence_refs",
    "workers"
  ],
  "properties": {
    "kind": {
      "const": "worker_capability_catalog"
    },
    "schema_version": {
      "const": "1.0"
    },
    "catalog_id": {
      "$ref": "#/$defs/catalogId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "candidate_status": {
      "const": "candidate_only"
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/worker"
      }
    }
  },
  "$defs": {
    "catalogId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,62}[a-z0-9]$"
    },
    "workerId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,62}[a-z0-9]$"
    },
    "capabilityId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,62}[a-z0-9]$"
    },
    "artifactRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9+.-]*:[A-Za-z0-9][A-Za-z0-9._/@+-]{1,150}$"
    },
    "kindId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]{1,63}$"
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "label",
        "candidate_status",
        "capabilities"
      ],
      "properties": {
        "worker_id": {
          "$ref": "#/$defs/workerId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "\\S"
        },
        "candidate_status": {
          "const": "candidate_only"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "name",
        "description",
        "input_kinds",
        "output_kinds",
        "risk_class",
        "evidence_required",
        "max_concurrency"
      ],
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/capabilityId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "input_kinds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kindId"
          }
        },
        "output_kinds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kindId"
          }
        },
        "risk_class": {
          "enum": [
            "inspect",
            "reversible_change",
            "privileged_change"
          ]
        },
        "evidence_required": {
          "type": "boolean"
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    }
  }
}
