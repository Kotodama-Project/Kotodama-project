{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kotodama-Project/Kotodama-project/schemas/block.schema.json",
  "title": "Kotodama Reusable Block",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "spec_version",
    "id",
    "status",
    "purpose",
    "inputs",
    "outputs",
    "authority",
    "verification",
    "rollback",
    "stop_conditions"
  ],
  "properties": {
    "kind": {"const": "block"},
    "spec_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "status": {
      "enum": ["example", "draft", "candidate_only", "locally_verified"]
    },
    "purpose": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_role", "allowed_actions", "denied_actions", "expires_at"],
      "properties": {
        "owner_role": {"type": "string", "minLength": 1},
        "allowed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["local_preview", "synthetic_validation", "read_only", "draft", "analyze"]
          }
        },
        "denied_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success_conditions", "negative_tests", "receipt_required"],
      "properties": {
        "success_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "negative_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "receipt_required": {"const": true}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "verify"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "verify": {"type": "string", "minLength": 1}
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
