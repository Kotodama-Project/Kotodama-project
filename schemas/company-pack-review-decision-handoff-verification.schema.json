{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kotodama-Project/Kotodama-project/schemas/company-pack-review-decision-handoff-verification.schema.json",
  "title": "Kotodama Company Pack Review Decision Handoff Verification",
  "$comment": "A match proves the saved handoff and its five-source chain match current inputs. It does not verify identity, authority, independence, approval, an overall Decision, evidence, Promotion, Current Truth, runtime readiness, Final Human GO, or Public Beta GO.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "status", "reason", "pack_id", "artifact_bindings", "handoff_binding", "candidate_binding", "source_checks", "review_summary", "unresolved_evidence", "decision_requirements", "claims", "public_beta"],
  "properties": {
    "kind": {"const": "company_pack_review_decision_handoff_verification"},
    "version": {"const": "1.0"},
    "status": {"enum": ["DECISION_HANDOFF_MATCH", "DECISION_HANDOFF_MISMATCH"]},
    "reason": {"oneOf": [{"type": "null"}, {"enum": ["HANDOFF_INVALID", "SOURCE_INVALID", "HANDOFF_MISMATCH", "SOURCE_DRIFT_DETECTED"]}]},
    "pack_id": {"oneOf": [{"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"}, {"type": "null"}]},
    "artifact_bindings": {"oneOf": [{"$ref": "#/$defs/artifact_bindings"}, {"type": "null"}]},
    "handoff_binding": {"oneOf": [{"$ref": "#/$defs/file_binding"}, {"type": "null"}]},
    "candidate_binding": {"oneOf": [{"$ref": "#/$defs/candidate_binding"}, {"type": "null"}]},
    "source_checks": {"$ref": "#/$defs/source_checks"},
    "review_summary": {"$ref": "#/$defs/review_summary"},
    "unresolved_evidence": {"$ref": "#/$defs/unresolved_evidence"},
    "decision_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "decision", "selected_outcome"],
      "properties": {
        "state": {"enum": ["HUMAN_DECISION_REQUIRED", "UNKNOWN"]},
        "decision": {"type": "null"},
        "selected_outcome": {"type": "null"}
      }
    },
    "claims": {"$ref": "#/$defs/claims"},
    "public_beta": {"const": "NO_GO_UNPUBLISHED"}
  },
  "$defs": {
    "file_binding": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "bytes"],
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}}
    },
    "artifact_bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle", "bundle_verification", "request", "response", "response_verification"],
      "properties": {"bundle": {"$ref": "#/$defs/file_binding"}, "bundle_verification": {"$ref": "#/$defs/file_binding"}, "request": {"$ref": "#/$defs/file_binding"}, "response": {"$ref": "#/$defs/file_binding"}, "response_verification": {"$ref": "#/$defs/file_binding"}}
    },
    "candidate_binding": {
      "type": "object", "additionalProperties": false, "required": ["saved_bundle", "bundle_digest", "binding_count"],
      "properties": {
        "saved_bundle": {"$ref": "#/$defs/file_binding"},
        "bundle_digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalization", "value"], "properties": {"algorithm": {"const": "SHA-256"}, "canonicalization": {"const": "utf8-json-sort-keys-no-whitespace-v1"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        "binding_count": {"type": "integer", "minimum": 1}
      }
    },
    "source_checks": {
      "type": "object", "additionalProperties": false, "required": ["current_bundle", "response"],
      "properties": {
        "current_bundle": {"type": "object", "additionalProperties": false, "required": ["status", "matched_bindings"], "properties": {"status": {"enum": ["MATCH", "UNKNOWN"]}, "matched_bindings": {"type": "integer", "minimum": 0}}},
        "response": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["ITEM_RESPONSES_MATCH_REQUEST", "UNKNOWN"]}}}
      }
    },
    "review_summary": {
      "type": "object", "additionalProperties": false, "required": ["state", "expected_items", "completed_items", "outcome_counts", "selected_outcome"],
      "properties": {
        "state": {"enum": ["ALL_ITEM_RESPONSES_PRESENT", "UNKNOWN"]},
        "expected_items": {"type": "integer", "minimum": 0},
        "completed_items": {"type": "integer", "minimum": 0},
        "outcome_counts": {"type": "object", "additionalProperties": false, "required": ["accept", "request_changes", "reject"], "properties": {"accept": {"type": "integer", "minimum": 0}, "request_changes": {"type": "integer", "minimum": 0}, "reject": {"type": "integer", "minimum": 0}}},
        "selected_outcome": {"type": "null"}
      }
    },
    "unresolved_evidence": {"type": "object", "additionalProperties": false, "required": ["state", "item_count"], "properties": {"state": {"enum": ["EVIDENCE_REQUIRED", "UNKNOWN"]}, "item_count": {"type": "integer", "minimum": 0}}},
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_identity_verified", "reviewer_authority_verified", "reviewer_independence_verified", "decision_maker_identity_verified", "decision_maker_authority_verified", "governed_review_completed", "human_approval_verified", "candidate_bound_human_decision_verified", "external_evidence_verified", "promotion_verified", "current_truth_changed", "runtime_ready", "final_human_go", "public_beta_go"],
      "properties": {"reviewer_identity_verified": {"const": false}, "reviewer_authority_verified": {"const": false}, "reviewer_independence_verified": {"const": false}, "decision_maker_identity_verified": {"const": false}, "decision_maker_authority_verified": {"const": false}, "governed_review_completed": {"const": false}, "human_approval_verified": {"const": false}, "candidate_bound_human_decision_verified": {"const": false}, "external_evidence_verified": {"const": false}, "promotion_verified": {"const": false}, "current_truth_changed": {"const": false}, "runtime_ready": {"const": false}, "final_human_go": {"const": false}, "public_beta_go": {"const": false}}
    }
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "DECISION_HANDOFF_MATCH"}}},
    "then": {"properties": {
      "reason": {"type": "null"}, "pack_id": {"type": "string"},
      "artifact_bindings": {"$ref": "#/$defs/artifact_bindings"}, "handoff_binding": {"$ref": "#/$defs/file_binding"}, "candidate_binding": {"$ref": "#/$defs/candidate_binding"},
      "source_checks": {"properties": {"current_bundle": {"properties": {"status": {"const": "MATCH"}, "matched_bindings": {"type": "integer", "minimum": 1}}}, "response": {"properties": {"status": {"const": "ITEM_RESPONSES_MATCH_REQUEST"}}}}},
      "review_summary": {"properties": {"state": {"const": "ALL_ITEM_RESPONSES_PRESENT"}, "expected_items": {"type": "integer", "minimum": 0}, "completed_items": {"type": "integer", "minimum": 0}}},
      "unresolved_evidence": {"properties": {"state": {"const": "EVIDENCE_REQUIRED"}, "item_count": {"type": "integer", "minimum": 0}}},
      "decision_requirements": {"properties": {"state": {"const": "HUMAN_DECISION_REQUIRED"}}}
    }},
    "else": {"properties": {
      "reason": {"type": "string"}, "pack_id": {"type": "null"}, "artifact_bindings": {"type": "null"}, "handoff_binding": {"type": "null"}, "candidate_binding": {"type": "null"},
      "source_checks": {"properties": {"current_bundle": {"properties": {"status": {"const": "UNKNOWN"}, "matched_bindings": {"const": 0}}}, "response": {"properties": {"status": {"const": "UNKNOWN"}}}}},
      "review_summary": {"properties": {"state": {"const": "UNKNOWN"}, "expected_items": {"const": 0}, "completed_items": {"const": 0}, "outcome_counts": {"properties": {"accept": {"const": 0}, "request_changes": {"const": 0}, "reject": {"const": 0}}}}},
      "unresolved_evidence": {"properties": {"state": {"const": "UNKNOWN"}, "item_count": {"const": 0}}},
      "decision_requirements": {"properties": {"state": {"const": "UNKNOWN"}}}
    }}
  }]
}
