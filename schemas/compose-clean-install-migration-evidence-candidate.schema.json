{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dj-thank/Kotodama-project/schemas/compose-clean-install-migration-evidence-candidate.schema.json",
  "title": "Kotodama Compose Clean Install and Migration Evidence Candidate",
  "$comment": "An unattested saved evidence candidate. Reported effects and checks are not authenticated, fresh, atomic, current runtime state, Promotion, Current Truth, Final Human GO, or Public Beta GO evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "status",
    "reported_at",
    "candidate_binding",
    "preflight_binding",
    "authorization_binding",
    "reported_effects",
    "service_reports",
    "claims",
    "evidence_candidate_sha256",
    "public_beta"
  ],
  "properties": {
    "kind": {"const": "compose_clean_install_migration_evidence_candidate"},
    "version": {"const": "1.0"},
    "status": {"const": "UNATTESTED_EVIDENCE_CANDIDATE"},
    "reported_at": {"type": "string", "format": "date-time"},
    "candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_file_sha256", "project_name", "resolved_contract_sha256", "image_manifest_digest"],
      "properties": {
        "candidate_file_sha256": {"$ref": "#/$defs/sha256"},
        "project_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,62}$"},
        "resolved_contract_sha256": {"$ref": "#/$defs/sha256"},
        "image_manifest_digest": {"$ref": "#/$defs/imageDigest"}
      }
    },
    "preflight_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight_file_sha256", "preflight_sha256", "daemon_id_sha256", "local_image_id_digest", "status"],
      "properties": {
        "preflight_file_sha256": {"$ref": "#/$defs/sha256"},
        "preflight_sha256": {"$ref": "#/$defs/sha256"},
        "daemon_id_sha256": {"$ref": "#/$defs/sha256"},
        "local_image_id_digest": {"$ref": "#/$defs/imageDigest"},
        "status": {"const": "LOCAL_IMAGE_AVAILABLE"}
      }
    },
    "authorization_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_order_sha256",
        "target_locator_sha256",
        "before_state_receipt_sha256",
        "executor_identity_sha256",
        "reviewer_identity_sha256",
        "identities_distinct",
        "protected_attestation_verified"
      ],
      "properties": {
        "work_order_sha256": {"$ref": "#/$defs/sha256"},
        "target_locator_sha256": {"$ref": "#/$defs/sha256"},
        "before_state_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "executor_identity_sha256": {"$ref": "#/$defs/sha256"},
        "reviewer_identity_sha256": {"$ref": "#/$defs/sha256"},
        "identities_distinct": {"const": true},
        "protected_attestation_verified": {"const": false}
      }
    },
    "reported_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_create_reported",
        "container_start_reported",
        "migration_execution_reported",
        "database_smoke_write_reported",
        "image_pull_reported",
        "image_mutation_reported",
        "daemon_configuration_change_reported",
        "credential_values_emitted",
        "raw_command_output_emitted",
        "raw_host_identity_emitted",
        "irreversible_delete_reported",
        "provider_transfer_reported"
      ],
      "properties": {
        "container_create_reported": {"const": true},
        "container_start_reported": {"const": true},
        "migration_execution_reported": {"const": true},
        "database_smoke_write_reported": {"const": true},
        "image_pull_reported": {"const": false},
        "image_mutation_reported": {"const": false},
        "daemon_configuration_change_reported": {"const": false},
        "credential_values_emitted": {"const": false},
        "raw_command_output_emitted": {"const": false},
        "raw_host_identity_emitted": {"const": false},
        "irreversible_delete_reported": {"const": false},
        "provider_transfer_reported": {"const": false}
      }
    },
    "service_reports": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/companyServiceReport"},
        {"$ref": "#/$defs/evidenceServiceReport"}
      ],
      "items": false
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_authenticity_verified",
        "observation_freshness_verified",
        "observation_atomicity_verified",
        "current_daemon_reachable_verified",
        "current_local_image_available_verified",
        "clean_install_verified",
        "services_started_verified",
        "migrations_verified",
        "database_positive_checks_verified",
        "database_negative_checks_verified",
        "application_least_privilege_verified",
        "restart_verified",
        "rollback_verified",
        "backup_verified",
        "restore_verified",
        "promotion_verified",
        "current_truth_changed",
        "final_human_go",
        "public_beta_go"
      ],
      "properties": {
        "execution_authenticity_verified": {"const": false},
        "observation_freshness_verified": {"const": false},
        "observation_atomicity_verified": {"const": false},
        "current_daemon_reachable_verified": {"const": false},
        "current_local_image_available_verified": {"const": false},
        "clean_install_verified": {"const": false},
        "services_started_verified": {"const": false},
        "migrations_verified": {"const": false},
        "database_positive_checks_verified": {"const": false},
        "database_negative_checks_verified": {"const": false},
        "application_least_privilege_verified": {"const": false},
        "restart_verified": {"const": false},
        "rollback_verified": {"const": false},
        "backup_verified": {"const": false},
        "restore_verified": {"const": false},
        "promotion_verified": {"const": false},
        "current_truth_changed": {"const": false},
        "final_human_go": {"const": false},
        "public_beta_go": {"const": false}
      }
    },
    "evidence_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "public_beta": {"const": "NO_GO_UNPUBLISHED"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "positiveChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migration_digest_match_reported", "required_tables_present_reported", "expected_roles_present_reported", "health_query_passed_reported", "transaction_write_read_rollback_reported"],
      "properties": {
        "migration_digest_match_reported": {"const": true},
        "required_tables_present_reported": {"const": true},
        "expected_roles_present_reported": {"const": true},
        "health_query_passed_reported": {"const": true},
        "transaction_write_read_rollback_reported": {"const": true}
      }
    },
    "negativeChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wrong_role_ddl_denied_reported", "wrong_role_write_denied_reported", "cross_store_access_denied_reported", "public_network_access_denied_reported", "dirty_schema_rejected_reported"],
      "properties": {
        "wrong_role_ddl_denied_reported": {"const": true},
        "wrong_role_write_denied_reported": {"const": true},
        "cross_store_access_denied_reported": {"const": true},
        "public_network_access_denied_reported": {"const": true},
        "dirty_schema_rejected_reported": {"const": true}
      }
    },
    "serviceReportBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "migration_path", "migration_sha256", "evidence_sha256", "positive_checks", "negative_checks"],
      "properties": {
        "service_id": {"type": "string"},
        "migration_path": {"type": "string"},
        "migration_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "positive_checks": {"$ref": "#/$defs/positiveChecks"},
        "negative_checks": {"$ref": "#/$defs/negativeChecks"}
      }
    },
    "companyServiceReport": {
      "allOf": [
        {"$ref": "#/$defs/serviceReportBase"},
        {"properties": {"service_id": {"const": "company-db"}, "migration_path": {"const": "company-db/001-company-core.sql"}}}
      ]
    },
    "evidenceServiceReport": {
      "allOf": [
        {"$ref": "#/$defs/serviceReportBase"},
        {"properties": {"service_id": {"const": "evidence-store"}, "migration_path": {"const": "evidence-store/001-evidence-core.sql"}}}
      ]
    }
  }
}
