{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dj-thank/Kotodama-project/schemas/company-pack-review-bundle.schema.json",
  "title": "Kotodama Company Pack Review Bundle",
  "$comment": "A candidate bundle binds static pack bytes only. It does not prove Human approval, authority, Promotion, Current Truth, runtime readiness, Final Human GO, or Public Beta GO.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "status",
    "reason",
    "pack_id",
    "source_checks",
    "bindings",
    "binding_count",
    "bundle_digest",
    "claims",
    "public_beta"
  ],
  "properties": {
    "kind": {"const": "company_pack_review_bundle"},
    "version": {"const": "1.0"},
    "status": {
      "enum": ["CANDIDATE_FOR_GOVERNED_REVIEW", "BUNDLE_REFUSED"]
    },
    "reason": {
      "oneOf": [
        {"type": "null"},
        {
          "enum": [
            "STRUCTURAL_VALIDATION_FAILED",
            "CUSTOMIZATION_REQUIRED",
            "SOURCE_DRIFT_DETECTED"
          ]
        }
      ]
    },
    "pack_id": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "source_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structural_validation", "customization"],
      "properties": {
        "structural_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "validated_files"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL"]},
            "validated_files": {"type": "integer", "minimum": 0}
          }
        },
        "customization": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "counts"],
              "properties": {
                "status": {
                  "enum": ["CUSTOMIZATION_REQUIRED", "READY_FOR_GOVERNED_REVIEW"]
                },
                "counts": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "replacement_required",
                    "review_required",
                    "evidence_required"
                  ],
                  "properties": {
                    "replacement_required": {"type": "integer", "minimum": 0},
                    "review_required": {"type": "integer", "minimum": 0},
                    "evidence_required": {"type": "integer", "minimum": 0}
                  }
                }
              }
            }
          ]
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "binding_count": {"type": "integer", "minimum": 0},
    "bundle_digest": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "canonicalization", "value"],
          "properties": {
            "algorithm": {"const": "SHA-256"},
            "canonicalization": {
              "const": "utf8-json-sort-keys-no-whitespace-v1"
            },
            "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_intent_authenticated",
        "human_approval_verified",
        "authority_assignment_verified",
        "retention_policy_verified",
        "candidate_bound_human_decision_verified",
        "promotion_verified",
        "current_truth_changed",
        "runtime_ready",
        "final_human_go",
        "public_beta_go"
      ],
      "properties": {
        "human_intent_authenticated": {"const": false},
        "human_approval_verified": {"const": false},
        "authority_assignment_verified": {"const": false},
        "retention_policy_verified": {"const": false},
        "candidate_bound_human_decision_verified": {"const": false},
        "promotion_verified": {"const": false},
        "current_truth_changed": {"const": false},
        "runtime_ready": {"const": false},
        "final_human_go": {"const": false},
        "public_beta_go": {"const": false}
      }
    },
    "public_beta": {"const": "NO_GO_UNPUBLISHED"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "CANDIDATE_FOR_GOVERNED_REVIEW"}}
      },
      "then": {
        "properties": {
          "reason": {"type": "null"},
          "binding_count": {"minimum": 1},
          "bundle_digest": {"type": "object"}
        }
      },
      "else": {
        "properties": {
          "reason": {"type": "string"},
          "bindings": {"maxItems": 0},
          "binding_count": {"const": 0},
          "bundle_digest": {"type": "null"}
        }
      }
    }
  ]
}
