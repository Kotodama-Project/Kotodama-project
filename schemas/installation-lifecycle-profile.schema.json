{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dj-thank/Kotodama-project/schemas/installation-lifecycle-profile.schema.json",
  "title": "Kotodama Installation Lifecycle Profile",
  "$comment": "A valid profile is only a sanitized planning and evidence contract. It does not prove installation, deployment, restart, restore, provider E2E, Promotion, Current Truth, Final Human GO, or Public Beta GO.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "spec_version",
    "id",
    "status",
    "profile",
    "purpose",
    "scope",
    "privacy",
    "governance",
    "profile_evidence",
    "phases",
    "claims",
    "public_beta"
  ],
  "properties": {
    "kind": {"const": "installation_lifecycle_profile"},
    "spec_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "status": {"enum": ["example", "candidate_only"]},
    "profile": {"enum": ["compose_minimum", "proxmox_segmented"]},
    "purpose": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "live_mutation_allowed", "runtime_values"],
      "properties": {
        "mode": {"const": "planning_and_evidence_contract"},
        "live_mutation_allowed": {"const": false},
        "runtime_values": {"const": "locator_only"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_values", "private_infrastructure_identifiers", "public_examples"],
      "properties": {
        "secret_values": {"const": "forbidden"},
        "private_infrastructure_identifiers": {"const": "locator_only"},
        "public_examples": {"const": "sanitized"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_phases_require_work_order",
        "candidate_digest_required",
        "receipt_required",
        "promotion_is_separate"
      ],
      "properties": {
        "material_phases_require_work_order": {
          "type": "array",
          "const": ["apply", "rollback", "restore_rehearsal"]
        },
        "candidate_digest_required": {"const": true},
        "receipt_required": {"const": true},
        "promotion_is_separate": {"const": true}
      }
    },
    "profile_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$"}
    },
    "phases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/phase"}
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_installation_verified",
        "deployment_verified",
        "restart_verified",
        "restore_verified",
        "provider_e2e_verified",
        "promotion_verified",
        "current_truth_changed",
        "final_human_go",
        "public_beta_go"
      ],
      "properties": {
        "live_installation_verified": {"const": false},
        "deployment_verified": {"const": false},
        "restart_verified": {"const": false},
        "restore_verified": {"const": false},
        "provider_e2e_verified": {"const": false},
        "promotion_verified": {"const": false},
        "current_truth_changed": {"const": false},
        "final_human_go": {"const": false},
        "public_beta_go": {"const": false}
      }
    },
    "public_beta": {"const": "NO_GO_UNPUBLISHED"}
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "effect",
        "requires_work_order",
        "required_evidence",
        "stop_conditions",
        "receipt_required",
        "rollback_ref"
      ],
      "properties": {
        "id": {
          "enum": [
            "preflight",
            "stage_candidate",
            "apply",
            "verify",
            "rollback",
            "restore_rehearsal"
          ]
        },
        "effect": {
          "enum": ["read_only", "local_reversible", "external_mutation", "isolated_mutation"]
        },
        "requires_work_order": {"type": "boolean"},
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$"}
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "receipt_required": {"const": true},
        "rollback_ref": {
          "oneOf": [
            {"type": "null"},
            {"const": "phase:rollback"}
          ]
        }
      }
    }
  }
}
