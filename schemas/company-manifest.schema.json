{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dj-thank/Kotodama-project/schemas/company-manifest.schema.json",
  "title": "Kotodama Company Template Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "spec_version",
    "id",
    "status",
    "human_intent_ref",
    "canonical_owners",
    "profiles",
    "blocks",
    "mocs",
    "denied_actions",
    "public_beta"
  ],
  "properties": {
    "kind": {"const": "company_template"},
    "spec_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "status": {
      "enum": ["example", "draft", "candidate_only", "locally_verified"]
    },
    "human_intent_ref": {"type": "string", "minLength": 1},
    "canonical_owners": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "human_intent",
        "decisions",
        "work_orders",
        "capability_grants",
        "verification_receipts",
        "promotions",
        "current_truth"
      ],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["compose_minimum", "proxmox_segmented"]}
    },
    "blocks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"}
    },
    "mocs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"}
    },
    "records": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"}
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_inputs", "sequence", "moc_ref"],
      "properties": {
        "entry_inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"}
        },
        "moc_ref": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
        }
      }
    },
    "denied_actions": {
      "type": "array",
      "uniqueItems": true,
      "allOf": [
        {"contains": {"const": "unbound_external_write"}},
        {"contains": {"const": "credential_permission_change"}},
        {"contains": {"const": "self_promotion"}},
        {"contains": {"const": "destructive_delete_without_rollback"}}
      ],
      "items": {"type": "string", "minLength": 1}
    },
    "public_beta": {"const": "NO_GO_UNPUBLISHED"}
  }
}
