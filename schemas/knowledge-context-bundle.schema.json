{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "package_sha256",
    "subject_sha256",
    "as_of",
    "errors",
    "claims",
    "kind",
    "status",
    "sensitivity_ceiling",
    "work_ref",
    "objective",
    "selected_claims",
    "sources",
    "assumptions",
    "questions",
    "contradictions",
    "omitted_ids",
    "context_sha256",
    "acceptance_criteria",
    "deliverable_bindings"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "package_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[A-Z_]+$"
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_approval_verified",
        "reviewer_identity_verified",
        "semantic_entailment_verified",
        "execution_authorized",
        "promotion_created",
        "current_truth_changed"
      ],
      "properties": {
        "human_approval_verified": {
          "const": false
        },
        "reviewer_identity_verified": {
          "const": false
        },
        "semantic_entailment_verified": {
          "const": false
        },
        "execution_authorized": {
          "const": false
        },
        "promotion_created": {
          "const": false
        },
        "current_truth_changed": {
          "const": false
        }
      }
    },
    "kind": {
      "const": "knowledge_context_bundle"
    },
    "status": {
      "enum": [
        "READY_CANDIDATE",
        "REFUSED"
      ]
    },
    "sensitivity_ceiling": {
      "$ref": "#/$defs/sensitivity"
    },
    "work_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "objective": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "selected_claims": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "kind",
          "sensitivity",
          "expires_at"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "kind": {
            "enum": [
              "synthetic_fixture",
              "local_snapshot"
            ]
          },
          "sensitivity": {
            "$ref": "#/$defs/sensitivity"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "maxLength": 40
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/contradiction"
      }
    },
    "omitted_ids": {
      "$ref": "#/$defs/refs"
    },
    "context_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "reported_state",
          "deliverable_refs"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "deliverable_refs": {
            "$ref": "#/$defs/refs"
          },
          "reported_state": {
            "enum": [
              "pending",
              "met"
            ]
          }
        }
      }
    },
    "deliverable_bindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "criterion_refs"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "criterion_refs": {
            "$ref": "#/$defs/refs"
          }
        }
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "blocking",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "blocking": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "open",
            "resolved"
          ]
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim_refs",
        "severity",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "claim_refs": {
          "$ref": "#/$defs/refs"
        },
        "severity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "state": {
          "enum": [
            "open",
            "resolved"
          ]
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "claim_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "claim_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "source_refs",
        "material",
        "sensitivity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "observation",
            "inference",
            "assumption"
          ]
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        },
        "material": {
          "type": "boolean"
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        }
      }
    }
  }
}
