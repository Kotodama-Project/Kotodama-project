{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kotodama/attestation-nonce-store-checkpoint-head-anchor-verification.schema.json",
  "title": "Attestation Nonce Store Checkpoint Head Anchor Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "status", "errors", "evaluated_at", "clock_source", "input_bindings", "counts", "claims", "public_beta"],
  "properties": {
    "kind": {"const": "attestation_nonce_store_checkpoint_head_anchor_verification"},
    "version": {"const": "1.0"},
    "status": {"enum": ["SIGNED_CHECKPOINT_HEAD_ANCHOR_MATCH", "INVALID"]},
    "errors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evaluated_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "clock_source": {"const": "supplied_evaluation_time_untrusted"},
    "input_bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_signers_file_sha256": {"$ref": "#/$defs/sha256"},
        "anchor_file_sha256": {"$ref": "#/$defs/sha256"},
        "anchor_id_sha256": {"$ref": "#/$defs/sha256"},
        "anchor_signature_file_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_file_sha256": {"$ref": "#/$defs/sha256"},
        "current_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "identity_file_sha256": {"$ref": "#/$defs/sha256"},
        "ssh_keygen_executable_sha256": {"$ref": "#/$defs/sha256"},
        "store_id_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoints_bound"],
      "properties": {
        "checkpoints_bound": {"type": "integer", "minimum": 0, "maximum": 1024}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_file_digest_match_verified", "supplied_bundle_digest_match_verified", "bundle_structure_verified", "bundle_head_binding_verified", "store_identity_binding_verified", "checkpoint_count_binding_verified", "anchor_signature_verified", "allowed_signer_verified", "signer_identity_binding_verified", "signer_role_policy_verified", "signed_evaluation_window_verified", "ssh_keygen_binary_binding_verified", "external_anchor_authority_verified", "trusted_clock_source_verified", "authoritative_complete_history_verified", "parallel_branch_absence_verified", "store_continuity_verified", "backup_execution_verified", "restore_execution_verified", "protected_runner_execution_verified", "signer_person_independence_verified", "promotion_verified", "current_truth_changed", "final_human_go", "public_beta_go", "ssh_keygen_vendor_authority_verified"],
      "properties": {
        "anchor_file_digest_match_verified": {"type": "boolean"},
        "supplied_bundle_digest_match_verified": {"type": "boolean"},
        "bundle_structure_verified": {"type": "boolean"},
        "bundle_head_binding_verified": {"type": "boolean"},
        "store_identity_binding_verified": {"type": "boolean"},
        "checkpoint_count_binding_verified": {"type": "boolean"},
        "anchor_signature_verified": {"type": "boolean"},
        "allowed_signer_verified": {"type": "boolean"},
        "signer_identity_binding_verified": {"type": "boolean"},
        "signer_role_policy_verified": {"type": "boolean"},
        "signed_evaluation_window_verified": {"type": "boolean"},
        "ssh_keygen_binary_binding_verified": {"type": "boolean"},
        "external_anchor_authority_verified": {"const": false},
        "trusted_clock_source_verified": {"const": false},
        "authoritative_complete_history_verified": {"const": false},
        "parallel_branch_absence_verified": {"const": false},
        "store_continuity_verified": {"const": false},
        "backup_execution_verified": {"const": false},
        "restore_execution_verified": {"const": false},
        "protected_runner_execution_verified": {"const": false},
        "signer_person_independence_verified": {"const": false},
        "promotion_verified": {"const": false},
        "current_truth_changed": {"const": false},
        "final_human_go": {"const": false},
        "public_beta_go": {"const": false},
        "ssh_keygen_vendor_authority_verified": {"const": false}
      }
    },
    "public_beta": {"const": "NO_GO_UNPUBLISHED"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SIGNED_CHECKPOINT_HEAD_ANCHOR_MATCH"}}},
      "then": {
        "properties": {
          "errors": {"maxItems": 0},
          "evaluated_at": {"type": "string", "format": "date-time"},
          "input_bindings": {"required": ["allowed_signers_file_sha256", "anchor_file_sha256", "anchor_id_sha256", "anchor_signature_file_sha256", "bundle_file_sha256", "current_checkpoint_sha256", "identity_file_sha256", "ssh_keygen_executable_sha256", "store_id_sha256"]},
          "counts": {"properties": {"checkpoints_bound": {"minimum": 1}}},
          "claims": {"$ref": "#/$defs/success_claims"}
        }
      },
      "else": {
        "properties": {
          "errors": {"minItems": 1},
          "counts": {"properties": {"checkpoints_bound": {"const": 0}}},
          "claims": {"$ref": "#/$defs/invalid_claims"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "success_claims": {"properties": {"anchor_file_digest_match_verified": {"const": true}, "supplied_bundle_digest_match_verified": {"const": true}, "bundle_structure_verified": {"const": true}, "bundle_head_binding_verified": {"const": true}, "store_identity_binding_verified": {"const": true}, "checkpoint_count_binding_verified": {"const": true}, "anchor_signature_verified": {"const": true}, "allowed_signer_verified": {"const": true}, "signer_identity_binding_verified": {"const": true}, "signer_role_policy_verified": {"const": true}, "signed_evaluation_window_verified": {"const": true}, "ssh_keygen_binary_binding_verified": {"const": true}}},
    "invalid_claims": {"properties": {"anchor_file_digest_match_verified": {"const": false}, "supplied_bundle_digest_match_verified": {"const": false}, "bundle_structure_verified": {"const": false}, "bundle_head_binding_verified": {"const": false}, "store_identity_binding_verified": {"const": false}, "checkpoint_count_binding_verified": {"const": false}, "anchor_signature_verified": {"const": false}, "allowed_signer_verified": {"const": false}, "signer_identity_binding_verified": {"const": false}, "signer_role_policy_verified": {"const": false}, "signed_evaluation_window_verified": {"const": false}, "ssh_keygen_binary_binding_verified": {"const": false}}}
  }
}
