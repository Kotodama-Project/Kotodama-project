{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kotodama/nonce-use-snapshot.schema.json",
  "title": "Nonce Use Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "snapshot_at", "used_nonce_sha256s"],
  "properties": {
    "kind": {"const": "nonce_use_snapshot"},
    "version": {"const": "1.0"},
    "snapshot_at": {"type": "string", "format": "date-time"},
    "used_nonce_sha256s": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
