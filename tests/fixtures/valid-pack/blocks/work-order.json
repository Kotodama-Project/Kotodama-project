{
  "kind": "block",
  "spec_version": "0.1",
  "id": "work-order-example",
  "status": "example",
  "purpose": "Produce a bounded work candidate.",
  "inputs": ["source_ref", "decision_ref"],
  "outputs": ["change_candidate", "verification_receipt"],
  "authority": {
    "owner_role": "human-owner",
    "allowed_actions": ["local_preview"],
    "denied_actions": ["external_write", "self_promotion"],
    "expires_at": "2099-01-01T00:00:00Z"
  },
  "verification": {
    "success_conditions": ["candidate digest recorded"],
    "negative_tests": ["reject missing decision"],
    "receipt_required": true
  },
  "rollback": {
    "action": "discard candidate",
    "verify": "candidate is not promoted"
  },
  "stop_conditions": ["source drift", "authority expiry"]
}
