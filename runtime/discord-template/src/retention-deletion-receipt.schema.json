{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content-free retention deletion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_revision",
    "receipt_ref",
    "session_ref",
    "archive_binding_digest",
    "policy_ref",
    "policy_revision_ref",
    "trigger",
    "deadline",
    "deleted_at",
    "artifacts",
    "retained_by_policy",
    "readback",
    "authority_granted",
    "gate_closed",
    "public_beta_go",
    "contains_content",
    "receipt_authenticity"
  ],
  "properties": {
    "kind": {
      "const": "kotodama.retention-deletion-receipt"
    },
    "schema_revision": {
      "const": "v1"
    },
    "receipt_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "pattern": "^ref/deletion-receipt/[a-z0-9][a-z0-9/_-]{1,240}$"
        }
      ]
    },
    "session_ref": {
      "$ref": "#/$defs/session_ref"
    },
    "archive_binding_digest": {
      "$ref": "#/$defs/sha256"
    },
    "policy_ref": {
      "$ref": "#/$defs/ref"
    },
    "policy_revision_ref": {
      "$ref": "#/$defs/ref"
    },
    "trigger": {
      "enum": [
        "expiry",
        "withdrawal",
        "source_delete"
      ]
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retain_until",
        "delete_by"
      ],
      "properties": {
        "retain_until": {
          "$ref": "#/$defs/timestamp"
        },
        "delete_by": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "deleted_at": {
      "$ref": "#/$defs/timestamp"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "count",
          "pre_delete_sha256",
          "manifest_entry_sha256"
        ],
        "properties": {
          "kind": {
            "$ref": "#/$defs/artifact_kind"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "pre_delete_sha256": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/$defs/sha256"
            }
          },
          "manifest_entry_sha256": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/$defs/sha256"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "retained_by_policy": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/artifact_kind"
      },
      "uniqueItems": true
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "residual_count",
        "checked_at"
      ],
      "properties": {
        "status": {
          "const": "CONFIRMED"
        },
        "residual_count": {
          "const": 0,
          "type": "integer"
        },
        "checked_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "authority_granted": {
      "const": false
    },
    "gate_closed": {
      "const": false
    },
    "public_beta_go": {
      "const": false
    },
    "contains_content": {
      "const": false
    },
    "receipt_authenticity": {
      "const": "UNVERIFIED"
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 7,
      "maxLength": 512,
      "pattern": "^ref/[a-z0-9][a-z0-9/_-]{1,510}$",
      "allOf": [
        {
          "$ref": "#/$defs/public_ref_safety"
        }
      ]
    },
    "session_ref": {
      "type": "string",
      "minLength": 12,
      "maxLength": 256,
      "pattern": "^ref/session/[a-z0-9][a-z0-9/_-]{1,244}$",
      "allOf": [
        {
          "$ref": "#/$defs/public_ref_safety"
        }
      ]
    },
    "public_ref_safety": {
      "allOf": [
        {
          "not": {
            "pattern": "[0-9]{17,20}"
          }
        },
        {
          "not": {
            "pattern": "(sk-|pk-|rk-|ghp_|gho_|github_pat_|xox[baprs]-|aiza|akia|eyj|bearer-)"
          }
        },
        {
          "not": {
            "pattern": "[@\\s\\\\:]"
          }
        },
        {
          "not": {
            "pattern": "(^|/)([0-9]{1,3}\\.){3}[0-9]{1,3}(/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)([a-z0-9-]+\\.)+[a-z]{2,}(/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)(https?://|file://|[A-Za-z]:[\\\\/]|\\\\\\\\)"
          }
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_kind": {
      "enum": [
        "RAW_AUDIO_PCM",
        "RAW_AUDIO_ENCODED",
        "RAW_AUDIO_SEGMENT",
        "RAW_SOURCE_JSON",
        "RAW_ASR",
        "ALIGNED_TRANSCRIPT",
        "SPEAKER_ATTRIBUTED_TRANSCRIPT",
        "CORRECTED_TRANSCRIPT",
        "MINUTES",
        "SOURCE_EVIDENCE"
      ]
    }
  }
}
