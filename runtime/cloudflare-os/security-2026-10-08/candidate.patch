+// Credentials need an explicit authorization-server identity. Legacy unstamped
+// records require reconnecting; discovering a new server cannot stamp them safely.
+function validIssuer(value: unknown): value is string {
+  if (typeof value !== "string" || !value || value.trim() !== value) return false;
+  try {
+    const url = new URL(value);
+    return (url.protocol === "https:" || url.protocol === "http:") &&
+      !url.username && !url.password && !url.search && !url.hash;
+  } catch {
+    return false;
+  }
+}
+
+function sameIssuer(left: unknown, right: unknown): boolean {
+  return validIssuer(left) && validIssuer(right) &&
+    (left === right || (left.endsWith("/") && left.slice(0, -1) === right) ||
+      (right.endsWith("/") && right.slice(0, -1) === left));
+}
+
+function discoveryIssuer(state: OAuthDiscoveryState | undefined): string | undefined {
+  if (!state || !validIssuer(state.authorizationServerUrl)) return undefined;
+  const metadata = state.authorizationServerMetadata;
+  if (metadata !== undefined) {
+    if (!metadata || typeof metadata !== "object") return undefined;
+    return sameIssuer(metadata.issuer, state.authorizationServerUrl) ? metadata.issuer : undefined;
+  }
+  return state.authorizationServerUrl;
+}
+
+function stampCredential<T extends { issuer?: string }>(value: T, contextIssuer?: string): T & { issuer: string } {
+  const issuer = value.issuer ?? contextIssuer;
+  if (!validIssuer(issuer) || (contextIssuer !== undefined && !sameIssuer(issuer, contextIssuer))) {
+    throw new Error("This MCP authorization identity is invalid. Please reconnect the account.");
+  }
+  return { ...value, issuer };
+}
+
+function bundleIssuer(
+  discovery: OAuthDiscoveryState | undefined,
+  client: StoredOAuthClientInformation | undefined,
+  tokens: OAuthTokens | undefined,
+): string | undefined {
+  const issuer = discoveryIssuer(discovery);
+  return issuer && sameIssuer(client?.issuer, issuer) && sameIssuer(tokens?.issuer, issuer)
+    ? issuer : undefined;
+}
