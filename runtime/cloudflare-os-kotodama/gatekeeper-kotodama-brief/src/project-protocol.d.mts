export type ProjectBrief = { outcome: string; in_scope: string[]; out_of_scope: string[]; constraints: string[]; acceptance: string[]; unknowns: string[] };
export type Project = { version: 1; project_id: string; revision: number; owner_ref: string; name: string; original_ref: string; brief: ProjectBrief; task_refs: string[] };
export type ProjectInput = { binding_sha256: string; expected_revision: number; base_digest: string; reason: string; brief: ProjectBrief };
export type ProjectView = { kind: "kotodama.project-owner-view"; version: 1; authority: "selected_local_project_owner"; project: Project; project_digest: string; snapshot: "current"; current_revision: number; source_refs: { key: string; revision: number; current_revision: number; freshness: "current" | "superseded" }[]; task_state_changed: false; execution_authorized: false };
export type ProjectResponse = { state: "not_connected" } | { state: "connected"; binding_sha256: string; can_inspect: boolean; view: ProjectView };
export type ProjectInspection = { kind: "kotodama.project-change-candidate"; version: 1; authority: "candidate_only"; project_id: string; expected_revision: number; base_digest: string; proposal_digest: string; proposal: { version: 1; project_id: string; expected_revision: number; base_digest: string; reason: string; source_ref: string; brief: ProjectBrief }; changed_fields: string[]; removed_requirements: { constraints: string[]; acceptance: string[] }; impact_task_refs: string[]; applied: false; next_action: "owner_revalidate_authorize_and_record_correction"; source_refs: { key: string; revision: number }[]; task_state_changed: false; execution_authorized: false };
export type ProjectInspectionResponse = { binding_sha256: string; inspection: ProjectInspection };
export const PROJECT_WIRE_BYTES: number;
export const PROJECT_INSPECTION_BYTES: number;
export function validateProjectBrief(value: unknown): ProjectBrief;
export function validateProjectView(value: unknown, projectId?: string): ProjectView;
export function validateProjectInput(value: unknown): ProjectInput;
export function validateProjectInspection(value: unknown, projectId?: string, input?: ProjectInput): ProjectInspection;
export function validateProjectResponse(value: unknown): ProjectResponse;
export function validateProjectInspectionResponse(value: unknown, input: ProjectInput): ProjectInspectionResponse;
