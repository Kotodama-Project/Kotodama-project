{
  "name": "gatekeeper-kotodama-brief",
  "main": ".wrangler/validate/src/kotodama.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "migrations": [{"tag": "v0", "new_sqlite_classes": ["AccountState", "KotodamaGatekeeper"]}],
  "observability": {"enabled": true, "logs": {"invocation_logs": false}}
}
